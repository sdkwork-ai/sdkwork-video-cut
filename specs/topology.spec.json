{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-video-cut",
  "applicationCode": "video_cut",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production",
        "demo"
      ]
    },
    "connectivityPlane": {
      "allowed": [
        "application",
        "platform"
      ]
    },
    "deploymentProfile": {
      "allowed": [
        "standalone"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "standalone.production",
    "desktopBuildProfileId": "standalone.production"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.demo": "etc/topology/standalone.demo.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_VIDEO_CUT_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_VIDEO_CUT_ENVIRONMENT",
    "profileId": "SDKWORK_VIDEO_CUT_PROFILE_ID",
    "clientDeploymentProfile": "VITE_SDKWORK_VIDEO_CUT_DEPLOYMENT_PROFILE",
    "standaloneGatewayBind": "SDKWORK_VIDEO_CUT_APPLICATION_PUBLIC_INGRESS_BIND"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_VIDEO_CUT_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_VIDEO_CUT_APPLICATION_PUBLIC_HTTP_URL"
    },
    "desktop.client": {
      "connectivityPlane": "application",
      "protocols": [
        "native"
      ],
      "optional": true
    }
  },
  "components": {
    "standaloneGateway": {
      "crate": "sdkwork-api-video-cut-standalone-gateway",
      "binary": "sdkwork-api-video-cut-standalone-gateway"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "standalone-gateway",
            "role": "api-standalone-gateway",
            "command": "cargo",
            "args": [
              "run",
              "--manifest-path",
              "crates/sdkwork-api-video-cut-standalone-gateway/Cargo.toml"
            ],
            "bindEnv": "SDKWORK_VIDEO_CUT_APPLICATION_PUBLIC_INGRESS_BIND",
            "required": true
          },
          {
            "id": "desktop-client",
            "package": "@sdkwork/autocut-desktop",
            "script": "dev:desktop",
            "runtimeTargets": [
              "desktop"
            ],
            "clientArchitectures": [
              "tauri"
            ],
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.production": {
        "processes": [],
        "healthSurfaces": []
      },
      "standalone.test": {
        "processes": [
          {
            "id": "standalone-gateway",
            "role": "api-standalone-gateway",
            "command": "cargo",
            "args": [
              "run",
              "--manifest-path",
              "crates/sdkwork-api-video-cut-standalone-gateway/Cargo.toml"
            ],
            "bindEnv": "SDKWORK_VIDEO_CUT_APPLICATION_PUBLIC_INGRESS_BIND",
            "required": true
          },
          {
            "id": "desktop-client",
            "package": "@sdkwork/autocut-desktop",
            "script": "dev:desktop",
            "runtimeTargets": [
              "desktop"
            ],
            "clientArchitectures": [
              "tauri"
            ],
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.staging": {
        "processes": [],
        "healthSurfaces": []
      },
      "standalone.demo": {
        "processes": [],
        "healthSurfaces": []
      }
    }
  },
  "packaging": {
    "targets": [],
    "cloudConfigFiles": []
  },
  "cloudPublicHosts": {
    "application.public-ingress": {
      "httpHost": "video-cut.sdkwork.com",
      "environments": {
        "development": {
          "httpHosts": [
            "video-cut-dev.sdkwork.com",
            "video-cut-dev.birdcoder.com",
            "video-cut-dev.dtupay.com",
            "video-cut-dev.sdkwork.cn",
