            "video-cut-dev.86offer.com",
            "video-cut-dev.86offer.cn"
          ]
        },
        "test": {
          "httpHosts": [
            "video-cut-test.sdkwork.com",
            "video-cut-test.birdcoder.com",
            "video-cut-test.dtupay.com",
