            "video-cut-demo.offer86.cn",
            "video-cut-demo.86offer.com",
            "video-cut-demo.86offer.cn"
          ]
        }
      },
      "httpHosts": [
        "video-cut.sdkwork.com",
        "video-cut.birdcoder.com",
        "video-cut.dtupay.com",
        "video-cut.sdkwork.cn",
        "video-cut.birdcoder.cn",
        "video-cut.dtupay.cn",
        "video-cut.skubc.com",
        "video-cut.skubc.cn",
        "video-cut.zowalk.com",
        "video-cut.zowalk.cn",
        "video-cut.offer86.com",
        "video-cut.offer86.cn",
        "video-cut.86offer.com",
        "video-cut.86offer.cn"
      ]
    }
  }
}
