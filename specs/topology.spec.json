            "video-cut-test.dtupay.cn",
            "video-cut-test.skubc.com",
            "video-cut-test.skubc.cn",
            "video-cut-test.zowalk.com",
            "video-cut-test.zowalk.cn",
            "video-cut-test.offer86.com",
            "video-cut-test.offer86.cn",
            "video-cut-test.86offer.com",
            "video-cut-test.86offer.cn"
          ]
        },
        "staging": {
          "httpHosts": [
            "video-cut-staging.sdkwork.com",
            "video-cut-staging.birdcoder.com",
            "video-cut-staging.dtupay.com",
            "video-cut-staging.sdkwork.cn",
            "video-cut-staging.birdcoder.cn",
            "video-cut-staging.dtupay.cn",
            "video-cut-staging.skubc.com",
            "video-cut-staging.skubc.cn",
            "video-cut-staging.zowalk.com",
            "video-cut-staging.zowalk.cn",
            "video-cut-staging.offer86.com",
            "video-cut-staging.offer86.cn",
            "video-cut-staging.86offer.com",
            "video-cut-staging.86offer.cn"
          ]
        },
        "demo": {
          "httpHosts": [
            "video-cut-demo.sdkwork.com",
