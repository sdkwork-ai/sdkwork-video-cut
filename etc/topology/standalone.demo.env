# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema `sdkwork_video_cut_demo`
# and a dedicated Redis logical DB index (`SDKWORK_VIDEO_CUT_REDIS_URL`) so no shared-redis cache
# key (rate-limit, session, idempotency) ever collides with another environment.
SDKWORK_VIDEO_CUT_DEPLOYMENT_PROFILE=standalone
SDKWORK_VIDEO_CUT_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_VIDEO_CUT_PROFILE_ID=standalone.demo
VITE_SDKWORK_VIDEO_CUT_DEPLOYMENT_PROFILE=standalone

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_VIDEO_CUT_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/ports (kept apart from development 8080) so a meaningfully distinct
# origin can be published externally for system demonstrations.
SDKWORK_VIDEO_CUT_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18074
SDKWORK_VIDEO_CUT_APPLICATION_PUBLIC_HTTP_URL=http://video-cut-demo.sdkwork.com:18074
