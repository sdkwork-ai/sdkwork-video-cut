# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema `sdkwork_video_cut_demo`
# and a dedicated Redis logical DB index (`SDKWORK_VIDEO_CUT_REDIS_URL`) so no shared-redis cache
# key (rate-limit, session, idempotency) ever collides with another environment.
SDKWORK_VIDEO_CUT_DEPLOYMENT_PROFILE=standalone
SDKWORK_VIDEO_CUT_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_VIDEO_CUT_PROFILE_ID=standalone.demo
VITE_SDKWORK_VIDEO_CUT_DEPLOYMENT_PROFILE=standalone

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_VIDEO_CUT_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/ports (kept apart from development 8080) so a meaningfully distinct
# origin can be published externally for system demonstrations.
SDKWORK_VIDEO_CUT_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18074
SDKWORK_VIDEO_CUT_APPLICATION_PUBLIC_HTTP_URL=http://video-cut-demo.sdkwork.com:18074
SDKWORK_CORS_ALLOWED_ORIGINS=https://video-cut-demo.sdkwork.com,http://video-cut-demo.sdkwork.com,https://video-cut-demo.birdcoder.com,http://video-cut-demo.birdcoder.com,https://video-cut-demo.dtupay.com,http://video-cut-demo.dtupay.com,https://video-cut-demo.noaper.com,http://video-cut-demo.noaper.com,https://video-cut-demo.sdkwork.cn,http://video-cut-demo.sdkwork.cn,https://video-cut-demo.birdcoder.cn,http://video-cut-demo.birdcoder.cn,https://video-cut-demo.dtupay.cn,http://video-cut-demo.dtupay.cn,https://video-cut-demo.noaper.cn,http://video-cut-demo.noaper.cn,https://video-cut-demo.skubc.com,http://video-cut-demo.skubc.com,https://video-cut-demo.skubc.cn,http://video-cut-demo.skubc.cn,https://video-cut-demo.zowalk.com,http://video-cut-demo.zowalk.com,https://video-cut-demo.zowalk.cn,http://video-cut-demo.zowalk.cn,https://video-cut-demo.offer86.com,http://video-cut-demo.offer86.com,https://video-cut-demo.offer86.cn,http://video-cut-demo.offer86.cn,https://video-cut-demo.86offer.com,http://video-cut-demo.86offer.com,https://video-cut-demo.86offer.cn,http://video-cut-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
